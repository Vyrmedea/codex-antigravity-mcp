{
  "name": "codex-antigravity-mcp",
  "version": "0.1.0",
  "description": "Lightweight local MCP server bridging Codex app-server to Antigravity and standard MCP clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codex-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "antigravity",
    "agent",
    "openai-codex"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
